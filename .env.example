# Copy to .env and fill in. Never commit .env.

# All three are required - the app fails at startup if any is missing. No
# default provider or model: pick one yourself and verify the model name is
# current against the provider's own docs (do not trust a guessed/recalled name).
LLM_PROVIDER=anthropic
LLM_MODEL=claude-opus-5-5
LLM_API_KEY=

# Optional. Leave unset to use each provider's normal API endpoint. Set this to
# point the openai-compatible client at a different host that serves the same
# API shape - e.g. Groq's OpenAI-compatible endpoint for open-weight models:
#   LLM_PROVIDER=openai
#   LLM_BASE_URL=https://api.groq.com/openai/v1
# A key from that host (not an OpenAI key) goes in LLM_API_KEY above.
LLM_BASE_URL=

# Optional, Anthropic only (ignored by the OpenAI adapter). Used by both Stage 1's
# CLI (as --effort's default) and POST /triage (when the request omits "effort").
# Falls back to "low" when unset entirely.
LLM_EFFORT=

# Pricing data lives in data/pricing.json, not in code - override this to point
# at a different file (e.g. once you've added verified OpenAI pricing).
PRICING_FILE=data/pricing.json

DATABASE_URL=postgresql://copilot:copilot@localhost:5432/copilot
REDIS_URL=redis://localhost:6379/0
